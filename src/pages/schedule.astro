---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
import { withBase } from '../lib/urls';
import { upcomingEvents } from '../lib/events';
import { programTheme } from '../lib/programs';
import ProgramBadge from '../components/programs/ProgramBadge.astro';
import RaceSchedule from '../components/programs/RaceSchedule.astro';
import EventCard from '../components/schedule/EventCard.astro';

const events = upcomingEvents(await getCollection('events'));
const programs = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);

// The page is split by what kind of date it is. Races come from src/content/races/ plus any
// one-off race events; everything that isn't a practice or a race is an event.
const practiceEvents = events.filter((event) => event.data.category === 'practice');
const raceEvents = events.filter((event) => event.data.category === 'race');
const otherEvents = events.filter(
  (event) => event.data.category !== 'practice' && event.data.category !== 'race',
);
const racePrograms = new Set((await getCollection('races')).map((series) => series.data.program));

const sectionLinks = [
  { href: '#practices', label: 'Practices' },
  { href: '#races', label: 'Races' },
  { href: '#events', label: 'Events' },
];
---

<BaseLayout
  title="Schedule"
  description="Practices, races, and club events for Flyers XC, Flyers Enduro/Gravity, and Jr. Flyers, with the race series each program follows."
>
  <section class="dark-surface flyers-banner-bg py-14 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-flyers-gold text-xs font-extrabold tracking-widest uppercase">Schedule</p>
      <h1
        class="font-display mt-3 max-w-3xl text-4xl leading-[0.98] font-black tracking-wide text-white uppercase sm:text-6xl"
      >
        What's coming up
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/90">
        Practices, races, and club events for every program. Pick a program to see only its dates.
        More dates are on the way, and we'll add them to a club calendar as they're set.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Semantic <search> landmark with visible radio filter pills (<6 choices) -->
      <search class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-xs">
        <form id="schedule-filter-form">
          <fieldset>
            <legend class="text-flyers-slate-dark text-xs font-extrabold tracking-wider uppercase">
              Show dates for
            </legend>
            <div class="mt-3 flex flex-wrap gap-2.5">
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-4 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="everything"
                  checked
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span>All programs</span>
              </label>
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-4 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="xc"
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span
                  data-program="xc"
                  class="bg-program-accent h-2.5 w-2.5 rounded-full"
                  aria-hidden="true"></span>
                <span>Flyers XC</span>
              </label>
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-4 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="enduro"
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span
                  data-program="enduro"
                  class="bg-program-accent h-2.5 w-2.5 rounded-full"
                  aria-hidden="true"></span>
                <span>Flyers Enduro/Gravity</span>
              </label>
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-4 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="jr-flyers"
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span
                  data-program="jr-flyers"
                  class="bg-program-accent h-2.5 w-2.5 rounded-full"
                  aria-hidden="true"></span>
                <span>Jr. Flyers</span>
              </label>
            </div>
          </fieldset>
        </form>
        <p
          id="schedule-filter-count"
          aria-live="polite"
          class="text-flyers-iron mt-3 text-xs font-semibold"
        >
          {
            events.length === 0
              ? 'No dated events on the calendar right now. Check back soon.'
              : `Showing all ${events.length} dated ${events.length === 1 ? 'event' : 'events'}`
          }
        </p>
      </search>

      <nav aria-label="Schedule sections" class="mt-6">
        <ul class="flex flex-wrap gap-2.5">
          {
            sectionLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-flyers-slate-dark hover:border-flyers-slate inline-flex min-h-12 items-center rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-extrabold underline-offset-4 hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section
        id="practices"
        aria-labelledby="schedule-practices-heading"
        class="schedule-group mt-12 scroll-mt-24"
      >
        <h2
          id="schedule-practices-heading"
          class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
        >
          Practices
        </h2>
        <p class="text-flyers-iron mt-2 max-w-3xl text-sm leading-relaxed sm:text-base">
          Each program's regular practice days, then the bigger rides with their own dates.
          Registered families get trailheads and weather changes in Slack.
        </p>

        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {
            programs.map((program) => (
              <article
                data-event-program={program.data.programId}
                data-program={programTheme(program.data.programId)}
                class="schedule-filterable border-t-program-accent rounded-2xl border border-t-4 border-neutral-200 bg-white p-6 shadow-xs"
              >
                <ProgramBadge program={program.data.programId} />
                <h3 class="font-display text-flyers-slate-dark mt-3 text-2xl font-black tracking-wide uppercase">
                  Weekly practices
                </h3>
                <ul class="text-flyers-iron mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed">
                  {program.data.practiceSchedule.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
                <a
                  href={withBase(`/programs/${program.data.programId}#when`)}
                  class="text-program-ink mt-2 inline-flex min-h-12 items-center text-sm font-extrabold underline"
                >
                  More about {program.data.title}
                </a>
              </article>
            ))
          }
        </div>

        {
          practiceEvents.length > 0 && (
            <div class="schedule-subgroup mt-10">
              <h3 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
                Upcoming rides
              </h3>
              <div class="mt-4 space-y-4">
                {practiceEvents.map((event) => (
                  <EventCard event={event} headingLevel={4} />
                ))}
              </div>
            </div>
          )
        }
      </section>

      <section
        id="races"
        aria-labelledby="schedule-races-heading"
        class="schedule-group mt-14 scroll-mt-24"
      >
        <h2
          id="schedule-races-heading"
          class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
        >
          Races
        </h2>
        <p class="text-flyers-iron mt-2 max-w-3xl text-sm leading-relaxed sm:text-base">
          Racing is optional. Riders who want to race pick the races that suit them, and coaches
          help them get ready. Sign up for each race on the organizer's site.
        </p>

        {
          raceEvents.length > 0 && (
            <div class="mt-6 space-y-4">
              {raceEvents.map((event) => (
                <EventCard event={event} />
              ))}
            </div>
          )
        }

        {
          racePrograms.has('xc') && (
            <div data-event-program="xc" class="schedule-filterable mt-8">
              <RaceSchedule
                program="xc"
                sectionId="races-xc"
                headingLevel={3}
                headingId="schedule-xc-races-heading"
                title="Flyers XC race schedule"
                intro="Flyers XC riders who want to race follow these series."
              />
            </div>
          )
        }

        {
          racePrograms.has('enduro') && (
            <div data-event-program="enduro" class="schedule-filterable mt-12">
              <RaceSchedule
                program="enduro"
                sectionId="races-enduro"
                headingLevel={3}
                headingId="schedule-enduro-races-heading"
                title="Flyers Enduro/Gravity race schedule"
                intro="Flyers Enduro/Gravity riders who want to race follow this series."
              />
            </div>
          )
        }

        <p
          data-empty-for="jr-flyers"
          class="text-flyers-iron mt-6 hidden rounded-2xl border border-neutral-200 bg-white p-6 text-sm"
        >
          Jr. Flyers doesn't race. It's weekly summer practices, all about riding for fun.
        </p>
      </section>

      <section
        id="events"
        aria-labelledby="schedule-events-heading"
        class="schedule-group mt-14 scroll-mt-24"
      >
        <h2
          id="schedule-events-heading"
          class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
        >
          Events
        </h2>
        <p class="text-flyers-iron mt-2 max-w-3xl text-sm leading-relaxed sm:text-base">
          Meetings, camps, clinics, and trail days.
        </p>
        <div class="mt-6 space-y-4">
          {otherEvents.map((event) => <EventCard event={event} />)}
        </div>
        <p
          data-empty-message
          class="text-flyers-iron mt-6 hidden rounded-2xl border border-neutral-200 bg-white p-6 text-sm"
        >
          No events for this program on the calendar right now. Check back soon.
        </p>
      </section>

      {
        siteConfig.integrations.googleCalendarEmbedUrl ? (
          <div class="mt-12 overflow-hidden rounded-2xl border border-neutral-200 bg-white p-4">
            <h2 class="font-display text-flyers-slate-dark mb-4 text-2xl font-black tracking-wide uppercase">
              Club calendar
            </h2>
            <iframe
              src={siteConfig.integrations.googleCalendarEmbedUrl}
              title="Flyers Cycling Club calendar"
              loading="lazy"
              class="h-[540px] w-full rounded-xl border-0"
            />
          </div>
        ) : (
          <div class="text-flyers-iron mt-12 rounded-2xl border border-neutral-200 bg-white p-6 text-sm">
            <h2 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
              More dates on the way
            </h2>
            <p class="mt-1 leading-relaxed">
              We're planning more rides and events and will add them to a club Google Calendar.
              Registered families get trailhead locations and weather changes from their program's
              volunteer leaders.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { todayInUtah } from '../lib/events';

  const form = document.getElementById('schedule-filter-form') as HTMLFormElement | null;
  const today = todayInUtah();
  // Everything the program filter can hide: event cards, weekly practice cards, and race lists.
  // Event cards whose last day has passed stay hidden (BaseLayout hides them too, if a rebuild
  // is missed).
  const items = Array.from(document.querySelectorAll<HTMLElement>('.schedule-filterable')).filter(
    (item) => !item.dataset.eventEnds || item.dataset.eventEnds >= today,
  );
  const subgroups = Array.from(document.querySelectorAll<HTMLElement>('.schedule-subgroup'));
  const emptyMessages = Array.from(document.querySelectorAll<HTMLElement>('[data-empty-message]'));
  const programNotes = Array.from(document.querySelectorAll<HTMLElement>('[data-empty-for]'));
  const countEl = document.getElementById('schedule-filter-count');

  const hasVisibleItem = (container: HTMLElement) =>
    items.some((item) => container.contains(item) && !item.classList.contains('hidden'));

  function applyFilter() {
    const selected = form
      ? String(new FormData(form).get('programFilter') || 'everything')
      : 'everything';
    let visibleCount = 0;

    for (const item of items) {
      const prog = item.dataset.eventProgram || 'all';
      const show = selected === 'everything' || prog === selected || prog === 'all';
      item.classList.toggle('hidden', !show);
      if (show && item.classList.contains('schedule-event-card')) visibleCount += 1;
    }

    for (const group of subgroups) group.classList.toggle('hidden', !hasVisibleItem(group));
    for (const message of emptyMessages) {
      const section = message.closest<HTMLElement>('section');
      message.classList.toggle('hidden', !section || hasVisibleItem(section));
    }
    for (const note of programNotes)
      note.classList.toggle('hidden', note.dataset.emptyFor !== selected);

    if (countEl) {
      countEl.textContent =
        visibleCount === 0
          ? 'No dated events for this program right now. Check back soon.'
          : `Showing ${selected === 'everything' ? 'all ' : ''}${visibleCount} dated ${visibleCount === 1 ? 'event' : 'events'}`;
    }
  }

  // Program pages link here with ?program=xc (or enduro, jr-flyers) to open the filtered list.
  const requested = new URLSearchParams(window.location.search).get('program');
  if (form && requested) {
    const radio = form.querySelector<HTMLInputElement>(
      `input[name="programFilter"][value="${CSS.escape(requested)}"]`,
    );
    if (radio) radio.checked = true;
  }

  form?.addEventListener('change', applyFilter);
  applyFilter();
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import { siteConfig } from '../data/site';
import { withBase } from '../lib/urls';

const { email } = siteConfig.contact;
---

<BaseLayout
  title="Help with costs"
  description="Flyers Cycling Club has help for families who need it. Here's how to ask, privately."
>
  <PageHero eyebrow="Help with costs" title="Cost shouldn't keep a kid off the bike">
    <p>{siteConfig.costHelp.summary}</p>
  </PageHero>

  <div class="py-14 sm:py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <section
        aria-labelledby="cost-ask-heading"
        class="border-t-flyers-red rounded-2xl border border-t-4 border-neutral-200 bg-white p-6 shadow-xs sm:p-8 md:col-span-2"
      >
        <h2
          id="cost-ask-heading"
          class="font-display text-flyers-slate-dark text-3xl font-black tracking-wide uppercase"
        >
          How to ask
        </h2>
        <p class="text-flyers-charcoal mt-3 text-base leading-relaxed">
          Talk to your rider's coach, or email <a
            href={`mailto:${email}?subject=Help%20with%20costs`}
            class="text-flyers-red-deep font-bold underline">{email}</a
          >. Tell us your rider's program and what would help. You don't need to explain why.
        </p>
        <a
          href={`mailto:${email}?subject=Help%20with%20costs`}
          class="bg-flyers-red hover:bg-flyers-red-deep font-display mt-6 inline-flex min-h-12 items-center justify-center rounded-xl px-6 py-3 text-lg font-extrabold tracking-wider text-white uppercase transition"
        >
          Email us &rarr;
        </a>
      </section>

      <section
        aria-labelledby="cost-what-heading"
        class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs sm:p-8 md:col-span-2"
      >
        <h2
          id="cost-what-heading"
          class="font-display text-flyers-slate-dark text-3xl font-black tracking-wide uppercase"
        >
          What a season costs
        </h2>
        <p class="text-flyers-charcoal mt-3 text-base leading-relaxed">
          {siteConfig.feePhilosophy.detail} Bikes, gear, race entries, and team kits are extra. The <a
            href={withBase('/faq')}
            class="text-flyers-red-deep font-bold underline">FAQ</a
          > lists each cost.
        </p>
      </section>

      <section
        aria-labelledby="cost-kinds-heading"
        class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs sm:p-8"
      >
        <h2
          id="cost-kinds-heading"
          class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase"
        >
          No forms, no rules
        </h2>
        <p class="text-flyers-iron mt-2 text-sm leading-relaxed">
          There's no application. Tell us what would help, and a board member will follow up with
          you privately.
        </p>
      </section>

      <section
        aria-labelledby="cost-give-heading"
        class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs sm:p-8"
      >
        <h2
          id="cost-give-heading"
          class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase"
        >
          Want to help a family ride?
        </h2>
        <p class="text-flyers-iron mt-2 text-sm leading-relaxed">
          Donations and sponsorships pay for this help. <a
            href={withBase('/support')}
            class="text-flyers-red-deep font-bold underline">See how to give</a
          >.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

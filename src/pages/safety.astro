---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import ComingSoon from '../components/layout/ComingSoon.astro';
import { siteConfig } from '../data/site';
import { programTheme } from '../lib/programs';
import { withBase } from '../lib/urls';

const programs = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);
const { email } = siteConfig.contact;
---

<BaseLayout
  title="Safety"
  description="How Flyers Cycling Club screens and trains coaches, the gear riders need, and how to raise a safety concern."
>
  <PageHero eyebrow="Safety" title="How we keep riders safe">
    <p>
      You're trusting volunteers with your kid. This page covers who coaches them, the gear they
      need, and who to call if something worries you.
    </p>
  </PageHero>

  <div class="py-14 sm:py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <section
        aria-labelledby="safety-coaches-heading"
        class="border-t-flyers-red rounded-2xl border border-t-4 border-neutral-200 bg-white p-6 shadow-xs sm:p-8 md:col-span-2"
      >
        <h2
          id="safety-coaches-heading"
          class="font-display text-flyers-slate-dark text-3xl font-black tracking-wide uppercase"
        >
          Who coaches your rider
        </h2>
        <p class="text-flyers-charcoal mt-3 text-base leading-relaxed">
          {siteConfig.coachScreening}
        </p>
        <!-- TODO(board): name the background check provider, and list any concussion (CDC HEADS UP),
             abuse-awareness, or first aid/CPR training Flyers coaches complete. Don't add any of these
             until the board confirms them. -->
        <p class="text-flyers-iron mt-3 text-sm leading-relaxed">
          Meet them on the <a
            href={withBase('/coaches')}
            class="text-flyers-red-deep font-bold underline">coaches page</a
          >.
        </p>
      </section>

      <section
        aria-labelledby="safety-gear-heading"
        class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs sm:p-8 md:col-span-2"
      >
        <h2
          id="safety-gear-heading"
          class="font-display text-flyers-slate-dark text-3xl font-black tracking-wide uppercase"
        >
          Helmets and gear
        </h2>
        <p class="text-flyers-charcoal mt-3 text-base leading-relaxed">
          Every program requires a helmet. Gravity riding needs more protection than a cross-country
          ride, so each program keeps its own gear list.
        </p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-3">
          {
            programs.map(({ data }) => (
              <li data-program={programTheme(data.accentKey)}>
                <a
                  href={withBase(`/programs/${data.programId}`)}
                  class="border-l-program-accent bg-flyers-snow hover:border-program-accent text-flyers-slate-dark flex min-h-12 items-center rounded-xl border border-l-4 border-neutral-200 px-4 py-3 text-sm font-extrabold transition"
                >
                  {data.title} gear list &rarr;
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- TODO(board): confirm the club's practice before filling these in. -->
      <ComingSoon id="safety-adults-heading" title="Two adults with every group">
        <p>
          How many coaches ride with each group, and our rule that no adult is alone with a rider.
        </p>
      </ComingSoon>

      <ComingSoon id="safety-injury-heading" title="Crashes and concussions">
        <p>What coaches do after a crash, and when a rider sits out and how they come back.</p>
      </ComingSoon>

      <ComingSoon id="safety-emergency-heading" title="Emergencies">
        <p>The emergency plan coaches carry on every ride, and how we reach you.</p>
      </ComingSoon>

      <ComingSoon id="safety-weather-heading" title="Weather calls">
        <p>When we cancel or move a ride for heat, cold, lightning, or mud, and how you'll hear.</p>
      </ComingSoon>

      <section
        aria-labelledby="safety-concern-heading"
        class="dark-surface flyers-banner-bg rounded-2xl p-6 text-white shadow-md sm:p-8 md:col-span-2"
      >
        <h2
          id="safety-concern-heading"
          class="font-display text-3xl font-black tracking-wide text-white uppercase"
        >
          Raise a concern
        </h2>
        <!-- TODO(board): name a safety contact (not a rider's own coach) and add a phone number. -->
        <p class="mt-3 text-base leading-relaxed text-white/90">
          If something on a ride worried you or your rider, tell us. Email <a
            href={`mailto:${email}?subject=Safety%20concern`}
            class="text-flyers-gold font-bold underline">{email}</a
          > and the board will follow up. If anyone is in danger, call 911 first.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

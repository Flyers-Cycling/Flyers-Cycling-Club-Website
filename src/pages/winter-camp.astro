---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
import { winterCamp } from '../data/winter-camp';
import { formatEventDate, formatEventDateRange } from '../lib/dates';
import { withBase } from '../lib/urls';

// TODO(board): before publishing trail days, call the BLM St. George Field Office
// (435-688-3200) to ask whether a club camp of this size needs a Special Recreation Permit
// for rides on BLM land (Santa Clara River Reserve, Zen, Grafton Mesa, JEM/Hurricane Cliffs, Prospector).
// Snake Hollow Bike Park is run by the City of St. George.

const dates = formatEventDateRange(winterCamp.startDate, winterCamp.endDate);
const questionsHref = `mailto:${siteConfig.contact.email}?subject=Winter%20camp`;
const money = (n: number) => `$${n.toLocaleString('en-US')}`;

type Track = 'camp' | 'skills' | 'xc' | 'gravity';
const trackMeta: Record<Track, { label: string; badgeClass: string }> = {
  camp: { label: 'Camp life', badgeClass: 'bg-neutral-200 text-flyers-slate-dark' },
  skills: { label: 'Skills, everyone together', badgeClass: 'bg-flyers-slate-dark text-white' },
  xc: { label: 'XC endurance ride', badgeClass: 'bg-flyers-red-deep text-white' },
  gravity: { label: 'Gravity ride', badgeClass: 'bg-flyers-pink-deep text-white' },
};

interface Session {
  time: string;
  track: Track;
  title: string;
  detail: string;
  wetWeather?: string;
}

const days: { date: string; theme: string; sessions: Session[] }[] = [
  {
    date: winterCamp.startDate,
    theme: 'Arrive and settle in',
    sessions: [
      {
        time: '7–9 PM',
        track: 'camp',
        title: 'Arrive at the condo',
        detail: 'Families eat dinner on the road. Unload bikes, find your room, and say hi.',
      },
      {
        time: '9 PM',
        track: 'camp',
        title: 'Rider meeting',
        detail: 'Meet your ride group, go over the weekend plan and house rules. Lights out 10:30.',
      },
    ],
  },
  {
    date: '2027-01-16',
    theme: 'Bike park skills, then split up',
    sessions: [
      {
        time: '9–11:30 AM',
        track: 'skills',
        title: 'Snake Hollow Bike Park',
        detail:
          'Groups rotate through stations: braking, cornering, pump track, and jump progressions. Lunch at the park.',
      },
      {
        time: '1–4:30 PM',
        track: 'xc',
        title: 'Santa Clara River Reserve',
        detail:
          'Barrel Roll and nearby loops, with distance set by group. Work on climbing technique, pacing, and eating on the bike.',
      },
      {
        time: '1–4:30 PM',
        track: 'gravity',
        // Randall (Nov 22, 2026): Saturday's gravity ride moves to Grafton Mesa. TODO(board): confirm
        // the trailhead and the drive time.
        title: 'Grafton Mesa',
        detail:
          'Mesa-top singletrack with views of Zion, near Rockville, about 45 minutes east of St. George. We drive over after lunch at the bike park.',
      },
      {
        time: 'Evening',
        track: 'camp',
        title: 'Dinner, pool, and hot tub',
        detail: 'Recovery time. Lights out 10:00.',
      },
    ],
  },
  {
    date: '2027-01-17',
    theme: 'Technical skills and the big ride',
    sessions: [
      {
        time: '9–11 AM',
        track: 'skills',
        title: 'Zen',
        detail:
          'Rocky ledges and slickrock moves. Walk a section, ride it, then ride it again. Zen holds up in the rain, so this session happens either way.',
        wetWeather:
          'If it’s dry and we have time: extend the session with laps on Bearclaw Poppy (rollers, drops, and line choice).',
      },
      {
        time: '12:30–4:30 PM',
        track: 'xc',
        title: 'JEM Trail and the Hurricane Cliffs',
        detail:
          'The long ride of the weekend, about 12–20 miles depending on the group. Lunch before we roll out.',
        wetWeather: 'If wet: Prospector to Church Rocks (the Hurricane trails are clay).',
      },
      {
        time: '12:30–4:30 PM',
        track: 'gravity',
        title: 'Paradise and City Creek',
        detail:
          'Ledges, rocks, and steep descents in the red bluffs north of town. Session the descents and work on braking and body position on steep terrain.',
      },
      {
        time: 'Evening',
        track: 'camp',
        title: 'Dinner, raffle, and awards',
        detail: 'Then a movie or games at the condo.',
      },
    ],
  },
  {
    date: winterCamp.endDate,
    theme: 'One more ride, then home',
    sessions: [
      {
        time: '8:30–11 AM',
        track: 'xc',
        title: 'Prospector to Church Rocks',
        detail:
          'A steady endurance ride on mostly smooth singletrack, finishing on the chunky sandstone of the Church Rocks loop.',
      },
      {
        time: '8:30–11 AM',
        track: 'gravity',
        title: 'Barrel',
        detail:
          'Jumps, big drops, and technical rock, a step up from Zen. Lap the features with coaches spotting.',
        wetWeather: 'If wet: Church Rocks instead.',
      },
      {
        time: '11 AM–2 PM',
        track: 'camp',
        title: 'Lunch and condo cleanup',
        detail: 'Everyone helps clean. Families are on the road by about 2 PM.',
      },
    ],
  },
];

const menu = [
  {
    meal: 'Breakfasts',
    items:
      'Saturday: oatmeal bar with berries, bananas, nuts, and honey, plus eggs and yogurt. Sunday: breakfast burritos with eggs, potatoes, black beans, and salsa. Monday: whole-grain pancakes, eggs, and fruit.',
  },
  {
    meal: 'Lunches',
    items:
      'Packed for the trail or the bike park: turkey or hummus wraps, sandwiches, fruit, pretzels, and cheese sticks. Monday lunch is leftovers and a sandwich bar before cleanup.',
  },
  {
    meal: 'Dinners',
    items:
      'Saturday: whole-wheat pasta with meat sauce or marinara, grilled chicken, and a big salad. Sunday: rice bowl and taco bar with chicken, beans, veggies, and salsa.',
  },
  {
    meal: 'Snacks and recovery',
    items:
      'Fruit, trail mix, granola bars, and pretzels all weekend. Chocolate milk after big rides, and electrolyte mix for every ride.',
  },
];

const volunteerJobs = [
  {
    role: 'Cook crew',
    detail: '3–4 adults shop ahead of time and cook the meals in the condo kitchen.',
  },
  {
    role: 'Ride leaders and sweeps',
    detail: 'One leader and one sweep for each of the 4 ride groups. You don’t need to be fast.',
  },
  {
    role: 'Drivers',
    detail:
      'Drive riders and bikes to trailheads. You’ll need a bike rack, and drivers cover their own gas.',
  },
  {
    role: 'Overnight chaperones',
    detail: 'Stay at the condo and help with meals, quiet hours, and lights out.',
  },
];

const packingList = [
  'Bike tuned before camp, with fresh tubeless sealant (desert thorns are everywhere)',
  'Helmet (required on every ride), gloves, and eye protection',
  'Layers: mornings are cold and afternoons are mild',
  'Hydration pack or 2 bottles, spare tube, pump, and multi-tool',
  'Swimsuit for the pool and hot tub',
];
---

<BaseLayout
  title="Winter Camp in St. George"
  description={`Flyers winter camp in St. George, Utah, ${dates}: four days of endurance riding and skills work for Flyers XC and Flyers Enduro/Gravity riders.`}
>
  <section class="dark-surface flyers-banner-bg py-14 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-flyers-gold text-xs font-extrabold tracking-widest uppercase">
        Flyers XC + Flyers Enduro/Gravity
      </p>
      <h1
        class="font-display mt-3 max-w-3xl text-4xl leading-[0.98] font-black tracking-wide text-white uppercase sm:text-6xl"
      >
        Winter camp in St. George
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/90">
        Four days of desert riding over MLK weekend. Build endurance, sharpen your skills, and get a
        head start on spring with your teammates. You don’t need to be fast to come.
      </p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="bg-flyers-slate-dark/85 rounded-xl border border-white/15 p-4">
          <dt class="text-flyers-silver text-xs font-extrabold tracking-wider uppercase">When</dt>
          <dd class="mt-1 font-bold text-white">{dates}</dd>
        </div>
        <div class="bg-flyers-slate-dark/85 rounded-xl border border-white/15 p-4">
          <dt class="text-flyers-silver text-xs font-extrabold tracking-wider uppercase">Where</dt>
          <dd class="mt-1 font-bold text-white">{winterCamp.location}</dd>
        </div>
        <div class="bg-flyers-slate-dark/85 rounded-xl border border-white/15 p-4">
          <dt class="text-flyers-silver text-xs font-extrabold tracking-wider uppercase">Who</dt>
          <dd class="mt-1 font-bold text-white">{winterCamp.eligibility}</dd>
        </div>
        <div class="bg-flyers-slate-dark/85 rounded-xl border border-white/15 p-4">
          <dt class="text-flyers-silver text-xs font-extrabold tracking-wider uppercase">Cost</dt>
          <dd class="mt-1 font-bold text-white">
            Up to {money(winterCamp.maxPricePerPerson)} per person
          </dd>
        </div>
      </dl>

      <div class="mt-8 flex flex-wrap items-center gap-3.5">
        {
          winterCamp.registrationUrl ? (
            <a
              href={winterCamp.registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-flyers-red hover:bg-flyers-red-deep font-display inline-flex min-h-12 items-center justify-center rounded-xl px-6 py-3 text-lg font-extrabold tracking-wider text-white uppercase shadow-md transition"
            >
              Register for camp &rarr;
            </a>
          ) : (
            <p class="rounded-xl border border-white/25 px-5 py-3 font-bold text-white">
              Registration opens soon
            </p>
          )
        }
        <a
          href={questionsHref}
          class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/30 px-5 py-3 font-bold text-white transition hover:bg-white/10"
        >
          Questions? Email us
        </a>
      </div>
    </div>
  </section>

  <!-- Day-by-day plan -->
  <section aria-labelledby="camp-plan-heading" class="py-14 sm:py-18">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="camp-plan-heading"
        class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
      >
        The plan, day by day
      </h2>
      <p class="text-flyers-iron mt-3 max-w-3xl text-base leading-relaxed">
        Saturday and Sunday mornings are skills sessions for everyone. After that, riders split by
        focus: XC groups go long to build endurance, and gravity groups ride more technical,
        descent-focused trails. Each focus has an A and a B group matched by pace and skill, with a
        volunteer ride leader and a sweep. Riders pick XC or gravity when they register.
      </p>

      <ol class="mt-8 space-y-6">
        {
          days.map((day) => (
            <li class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs">
              <h3 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
                <time datetime={day.date}>{formatEventDate(day.date)}</time>
                <span class="text-flyers-iron"> · {day.theme}</span>
              </h3>
              <ul class="mt-4 grid gap-3 md:grid-cols-2">
                {day.sessions.map((session) => (
                  <li class="bg-flyers-snow rounded-xl border border-neutral-200 p-4">
                    <div class="flex flex-wrap items-center gap-2 text-xs">
                      <span
                        class={`rounded-full px-2.5 py-0.5 font-extrabold ${trackMeta[session.track].badgeClass}`}
                      >
                        {trackMeta[session.track].label}
                      </span>
                      <span class="text-flyers-iron font-bold">{session.time}</span>
                    </div>
                    <p class="text-flyers-slate-dark mt-2 font-extrabold">{session.title}</p>
                    <p class="text-flyers-iron mt-1 text-sm leading-relaxed">{session.detail}</p>
                    {session.wetWeather && (
                      <p class="text-flyers-iron mt-2 text-xs font-semibold">
                        {session.wetWeather}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>

      <div class="mt-8 max-w-3xl rounded-2xl border border-neutral-200 bg-white p-6">
        <h3 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
          If it rains
        </h3>
        <p class="text-flyers-iron mt-2 text-sm leading-relaxed">
          Some St. George trails are clay, which turns to sticky mud when wet and gets damaged if
          you ride it. If it rains, we skip Bearclaw Poppy and the Hurricane trails and ride sandy
          or slickrock trails instead. Ride leaders make the call each morning.
        </p>
      </div>
    </div>
  </section>

  <!-- Food -->
  <section
    aria-labelledby="camp-food-heading"
    class="border-y border-neutral-200 bg-white py-14 sm:py-16"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="camp-food-heading"
        class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
      >
        Food for big riding days
      </h2>
      <p class="text-flyers-iron mt-3 max-w-3xl text-base leading-relaxed">
        A volunteer cook crew makes 8 meals, from Saturday breakfast through Monday lunch, plus
        snacks all weekend. Meals focus on carbs for energy and protein for recovery. Tell us about
        allergies and dietary needs when you register and we’ll plan around them.
      </p>
      <dl class="mt-6 grid gap-4 md:grid-cols-2">
        {
          menu.map((m) => (
            <div class="bg-flyers-snow rounded-xl border border-neutral-200 p-5">
              <dt class="text-flyers-slate-dark font-extrabold">{m.meal}</dt>
              <dd class="text-flyers-iron mt-1 text-sm leading-relaxed">{m.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Cost -->
  <section aria-labelledby="camp-cost-heading" class="py-14 sm:py-18">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="lg:col-span-7">
        <h2
          id="camp-cost-heading"
          class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
        >
          What it costs
        </h2>
        <p class="text-flyers-iron mt-3 text-base leading-relaxed">
          Camp costs up to <strong class="text-flyers-slate-dark"
            >{money(winterCamp.maxPricePerPerson)} per person</strong
          >, for riders and adults alike. That covers 3 nights at the condo, 8 meals and snacks, and
          the evening fun.
        </p>
        <p class="text-flyers-iron mt-3 text-base leading-relaxed">
          The final price depends on how many people come. The condo costs the same no matter what,
          so the more people who sign up, the lower the price for everyone.
        </p>
        <p class="text-flyers-iron mt-3 text-sm leading-relaxed">
          Not included: travel to and from St. George, Friday dinner, bike parts or repairs, and
          spending money.
        </p>
      </div>

      <aside class="space-y-6 lg:col-span-5">
        <div class="rounded-2xl border border-neutral-200 bg-white p-6">
          <h3
            class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase"
          >
            How to pay
          </h3>
          <ul class="text-flyers-iron mt-3 space-y-2 text-sm leading-relaxed">
            <li>
              <strong class="text-flyers-slate-dark">{money(winterCamp.deposit)} deposit</strong> by {
                formatEventDate(winterCamp.depositDueDate)
              }. It holds your spot and isn’t refundable, because the club pays for the condo up
              front.
            </li>
            <li>
              After the deposit deadline, we’ll count heads and tell you the final price. The rest
              is due by {formatEventDate(winterCamp.balanceDueDate)}.
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- Supervision & volunteers -->
  <section
    aria-labelledby="camp-adults-heading"
    class="border-y border-neutral-200 bg-white py-14 sm:py-16"
  >
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <h2
          id="camp-adults-heading"
          class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
        >
          Who’s in charge
        </h2>
        <!-- TODO(board): confirm the supervision plan below, and add the screening and training
             camp volunteers complete, before publishing. -->
        <p class="text-flyers-iron mt-3 text-base leading-relaxed">
          Riders can come without a parent. Volunteer coaches and parent chaperones stay at the
          condo all weekend. Riders sleep in rooms grouped by gender and age, and adults have their
          own rooms.
        </p>
        <p class="text-flyers-iron mt-3 text-base leading-relaxed">
          Parents are welcome to come too. Adults pay the same rate as riders and take on a camp
          job. It takes about 15 adults to make camp work.
        </p>
      </div>
      <div>
        <h3 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
          Volunteer jobs
        </h3>
        <dl class="mt-3 space-y-3">
          {
            volunteerJobs.map((job) => (
              <div class="bg-flyers-snow rounded-xl border border-neutral-200 p-4">
                <dt class="text-flyers-slate-dark font-extrabold">{job.role}</dt>
                <dd class="text-flyers-iron mt-1 text-sm leading-relaxed">{job.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Packing -->
  <section aria-labelledby="camp-packing-heading" class="py-14 sm:py-18">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="camp-packing-heading"
        class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
      >
        What to bring
      </h2>
      <ul class="text-flyers-iron mt-5 grid gap-3 text-sm sm:grid-cols-2">
        {
          packingList.map((item) => (
            <li class="flex items-start gap-3 rounded-xl border border-neutral-200 bg-white p-4">
              <span
                class="bg-flyers-red mt-1.5 inline-block h-2.5 w-2.5 shrink-0 rounded-full"
                aria-hidden="true"
              />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="text-flyers-iron mt-8 text-sm">
        Questions about camp? Email <a
          href={questionsHref}
          class="text-flyers-red-deep font-bold underline">{siteConfig.contact.email}</a
        >. See the rest of the season on the <a
          href={withBase('/schedule')}
          class="text-flyers-red-deep font-bold underline">schedule</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>

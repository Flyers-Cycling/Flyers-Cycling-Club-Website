---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import { siteConfig } from '../data/site';
import { programTheme } from '../lib/programs';
import { withBase } from '../lib/urls';

// Coaches from the leadership collection (coach: true). The board has its own page.
const leads = (await getCollection('leadership'))
  .filter((entry) => entry.data.coach)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Coaches"
  description="Meet the volunteer coaches and ride leaders of Flyers XC, Flyers Enduro/Gravity, and Jr. Flyers."
>
  <PageHero eyebrow="Our coaches" title="Meet the coaches">
    <p>
      Flyers coaches and ride leaders are volunteers who love riding and want your rider to love it
      too.
    </p>
  </PageHero>

  <section aria-labelledby="coach-leads-heading" class="py-14 sm:py-16">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">
      <div>
        <h2
          id="coach-leads-heading"
          class="font-display text-flyers-slate-dark text-3xl font-black tracking-wide uppercase sm:text-4xl"
        >
          Program coaches
        </h2>
        <figure
          class="mt-6 overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-xs"
        >
          <img
            src={withBase('/images/coaches/head-coaches.jpg')}
            alt="Jessie, Tim, and Randall standing together outdoors in Flyers shirts, with mountains behind them."
            width="1400"
            height="788"
            class="aspect-[16/9] w-full object-cover"
          />
          <figcaption class="text-flyers-iron px-5 py-3 text-sm">
            Head coaches, from left: Jessie Shepherd (Jr. Flyers), Tim Richards (Flyers
            Enduro/Gravity), and Randall Adams (Flyers XC).
          </figcaption>
        </figure>
        <!-- TODO(board): photo of Tim Richards (with consent). -->
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            leads.map((lead) => (
              <article
                data-program={programTheme(lead.data.program)}
                class="border-t-program-accent overflow-hidden rounded-2xl border border-t-4 border-neutral-200 bg-white shadow-xs"
              >
                {lead.data.photo && (
                  <img
                    src={withBase(lead.data.photo)}
                    alt={lead.data.photoAlt ?? ''}
                    width="768"
                    height="768"
                    loading="lazy"
                    class="aspect-square w-full object-cover object-top"
                  />
                )}
                <div class="p-6">
                  <p class="text-program-ink text-xs font-extrabold tracking-wide uppercase">
                    {lead.data.programFocus}
                  </p>
                  <h3 class="font-display text-flyers-slate-dark mt-1.5 text-2xl font-black tracking-wide uppercase">
                    {lead.data.name}
                  </h3>
                  <p class="text-flyers-slate text-xs font-bold">{lead.data.role}</p>
                  <div class="text-flyers-iron mt-3 space-y-3 text-sm leading-relaxed">
                    {(lead.data.fullBio ?? lead.data.bio).split(/\n\s*\n/).map((para) => (
                      <p>{para.trim()}</p>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <p class="text-flyers-iron text-sm">
        Coaches and ride leaders: see the <a
          href={withBase('/coaches/resources')}
          class="text-flyers-red-deep font-bold underline">coach resources</a
        >.
      </p>

      <section
        aria-labelledby="coach-training-heading"
        class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs sm:p-8"
      >
        <h2
          id="coach-training-heading"
          class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase"
        >
          Coach screening and training
        </h2>
        <!-- TODO(board): add the background check provider and any other training once confirmed. -->
        <p class="text-flyers-iron mt-2 text-sm leading-relaxed">
          {siteConfig.coachScreening} More on the <a
            href={withBase('/safety')}
            class="text-flyers-red-deep font-bold underline">safety page</a
          >.
        </p>
      </section>

      <p class="text-flyers-iron text-sm">
        Want to help coach or lead rides? Email <a
          href={`mailto:${siteConfig.contact.email}?subject=Coaching%20with%20Flyers`}
          class="text-flyers-red-deep font-bold underline">{siteConfig.contact.email}</a
        >. You don't need to be fast.
      </p>
    </div>
  </section>
</BaseLayout>

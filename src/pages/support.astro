---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import { siteConfig } from '../data/site';
import { donateLink } from '../lib/donate';
import { withBase } from '../lib/urls';

const donate = donateLink();
const card = 'rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs sm:p-8';
const heading = 'font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase';
const link =
  'text-flyers-red-deep mt-4 inline-flex min-h-12 items-center text-sm font-extrabold underline';
---

<BaseLayout
  title="Support the club"
  description="Donate, sponsor, volunteer, or shop to help Flyers Cycling Club keep youth mountain biking low cost in Utah."
>
  <PageHero eyebrow="Support" title="Help more kids ride">
    <p>
      Flyers runs on volunteers, local sponsors, and donors. Registration only covers a rider's
      t-shirt and insurance, so every gift and every hour helps.
    </p>
  </PageHero>

  <div class="py-14 sm:py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <section
        id="donate"
        aria-labelledby="support-donate-heading"
        class="border-t-flyers-red rounded-2xl border border-t-4 border-neutral-200 bg-white p-6 shadow-xs sm:p-8 md:col-span-2"
      >
        <h2
          id="support-donate-heading"
          class="font-display text-flyers-slate-dark text-3xl font-black tracking-wide uppercase"
        >
          Donate
        </h2>
        <p class="text-flyers-charcoal mt-3 text-base leading-relaxed">
          Gifts of any size pay for coach training, first aid and repair gear, race-day tents, trail
          days, and help for families who need it. {siteConfig.legalEntity} is a 501(c)(3) non-profit,
          so gifts are tax-deductible to the extent allowed by law.
        </p>
        <a
          href={donate.href}
          target={donate.external ? '_blank' : undefined}
          rel={donate.external ? 'noopener noreferrer' : undefined}
          class="bg-flyers-red hover:bg-flyers-red-deep font-display mt-6 inline-flex min-h-12 items-center justify-center rounded-xl px-6 py-3 text-lg font-extrabold tracking-wider text-white uppercase transition"
        >
          {donate.label} &rarr;
        </a>
      </section>

      <section aria-labelledby="support-sponsor-heading" class={card}>
        <h2 id="support-sponsor-heading" class={heading}>Sponsor</h2>
        <p class="text-flyers-iron mt-2 text-sm leading-relaxed">
          Businesses can back the whole club or one program.
        </p>
        <a href={withBase('/sponsors')} class={link}>See sponsorship levels &rarr;</a>
      </section>

      <section aria-labelledby="support-volunteer-heading" class={card}>
        <h2 id="support-volunteer-heading" class={heading}>Volunteer</h2>
        <p class="text-flyers-iron mt-2 text-sm leading-relaxed">
          Sweep a ride, run the race tent, or take photos. You don't need to be fast.
        </p>
        <a href={withBase('/volunteer')} class={link}>Ways to help &rarr;</a>
      </section>

      <section aria-labelledby="support-shop-heading" class={card}>
        <h2 id="support-shop-heading" class={heading}>Shop</h2>
        <p class="text-flyers-iron mt-2 text-sm leading-relaxed">
          Team kits and club gear, ordered in winter.
        </p>
        <a href={withBase('/store')} class={link}>Team kits and shop &rarr;</a>
      </section>

      <section aria-labelledby="support-help-heading" class={card}>
        <h2 id="support-help-heading" class={heading}>Need help with costs?</h2>
        <p class="text-flyers-iron mt-2 text-sm leading-relaxed">{siteConfig.costHelp.summary}</p>
        <a href={withBase('/scholarships')} class={link}>How to ask &rarr;</a>
      </section>
    </div>
  </div>
</BaseLayout>

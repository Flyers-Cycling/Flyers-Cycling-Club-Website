---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
import { formatPostDate } from '../lib/dates';
import { isPlaceholderUrl } from '../lib/urls';

// Until the real Zeffy shop link is set, send families to email instead of a bare zeffy.com page.
const shopReady = !isPlaceholderUrl(siteConfig.integrations.zeffyShopUrl);
const shopHref = shopReady
  ? siteConfig.integrations.zeffyShopUrl
  : `mailto:${siteConfig.contact.email}?subject=Club%20shop%20order`;

// Same for the Volt kit store: until it has its own link, email us instead of the old site's home page.
const kitReady = !isPlaceholderUrl(siteConfig.integrations.voltKitStore.url);
const kitHref = kitReady
  ? siteConfig.integrations.voltKitStore.url
  : `mailto:${siteConfig.contact.email}?subject=Team%20kit%20order`;

const updates = (await getCollection('updates')).sort((a, b) =>
  b.data.publishedDate.localeCompare(a.data.publishedDate),
);

const renderedUpdates = await Promise.all(
  updates.map(async (entry) => ({
    entry,
    rendered: await render(entry),
  })),
);
---

<BaseLayout
  title="Team Kits & News"
  description="Order optional Flyers team kits from Volt Cyclewear, buy family gear from the club shop, and read the latest Flyers Cycling Club news."
>
  <section class="dark-surface flyers-banner-bg py-14 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-flyers-gold text-xs font-extrabold tracking-widest uppercase">Club store</p>
      <h1
        class="font-display mt-3 max-w-3xl text-4xl leading-[0.98] font-black tracking-wide text-white uppercase sm:text-6xl"
      >
        Team kits and news
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/90">
        Team kits are optional. Every registered rider already gets a club t-shirt, and our jerseys
        are made to go with plain black shorts you may already own.
      </p>
    </div>
  </section>

  <!-- Kit & Merch Cards -->
  <section aria-labelledby="gear-stores-heading" class="py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="gear-stores-heading"
        class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
      >
        Kits and club gear
      </h2>

      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        <!-- Volt Cyclewear Custom Kit Store -->
        <article
          class="border-t-flyers-slate flex flex-col justify-between rounded-2xl border border-t-4 border-neutral-200 bg-white p-7 shadow-xs"
        >
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span
                class="border-flyers-slate/25 bg-flyers-slate-light text-flyers-slate-dark rounded-full border px-3 py-1 text-xs font-extrabold"
              >
                {siteConfig.integrations.voltKitStore.vendor}
              </span>
              <span
                class="border-flyers-gold bg-flyers-gold-light text-flyers-gold-ink rounded-full border px-3 py-1 text-xs font-bold"
              >
                {siteConfig.integrations.voltKitStore.windowLabel}
              </span>
            </div>
            <h3
              class="font-display text-flyers-slate-dark mt-4 text-3xl font-black tracking-wide uppercase"
            >
              Flyers team kits
            </h3>
            <p class="text-flyers-iron mt-3 text-sm leading-relaxed">
              {siteConfig.integrations.voltKitStore.notes}
            </p>
            <ul class="text-flyers-iron mt-4 space-y-2 text-xs">
              <li class="flex items-start gap-2">
                <span class="text-flyers-red font-black" aria-hidden="true">&#10003;</span>
                <span>Stretchy XC and trail jerseys, plus Alpine Thermal layers for cold rides</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-flyers-red font-black" aria-hidden="true">&#10003;</span>
                <span>Made to match plain black bibs or mountain bike shorts</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-flyers-red font-black" aria-hidden="true">&#10003;</span>
                <span>Carries the logos of the sponsors who support the club</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4">
            <a
              href={kitHref}
              target={kitReady ? '_blank' : undefined}
              rel={kitReady ? 'noopener noreferrer' : undefined}
              class="bg-flyers-slate hover:bg-flyers-slate-dark font-display inline-flex min-h-12 items-center justify-center rounded-xl px-6 py-2.5 text-base font-extrabold tracking-wider text-white uppercase transition"
            >
              {kitReady ? 'See kit order details' : 'Email us about kits'} &rarr;
            </a>
          </div>
        </article>

        <!-- Zeffy Enduro & Supporter Shop -->
        <article
          class="border-t-flyers-red flex flex-col justify-between rounded-2xl border border-t-4 border-neutral-200 bg-white p-7 shadow-xs"
        >
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span
                class="border-flyers-red-signature/40 bg-flyers-red-light text-flyers-red-deep rounded-full border px-3 py-1 text-xs font-extrabold"
              >
                Zeffy
              </span>
            </div>
            <h3
              class="font-display text-flyers-slate-dark mt-4 text-3xl font-black tracking-wide uppercase"
            >
              Club shop
            </h3>
            <p class="text-flyers-iron mt-3 text-sm leading-relaxed">
              Every registered rider already gets a club t-shirt with registration. Extra tees for
              parents and siblings, hats, stickers, and Flyers Enduro/Gravity apparel are in our
              Zeffy shop. Zeffy doesn't charge the club fees, so more of each purchase goes to the
              club.
            </p>
          </div>
          <div class="mt-6 pt-4">
            <a
              href={shopHref}
              target={shopReady ? '_blank' : undefined}
              rel={shopReady ? 'noopener noreferrer' : undefined}
              class="bg-flyers-red hover:bg-flyers-red-bright font-display inline-flex min-h-12 items-center justify-center rounded-xl px-6 py-2.5 text-base font-extrabold tracking-wider text-white uppercase transition"
            >
              {shopReady ? 'Visit the club shop' : 'Email us to order'} &rarr;
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Club Announcements & Updates -->
  <section
    aria-labelledby="updates-heading"
    class="border-t border-neutral-200 bg-white py-14 sm:py-16"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="updates-heading"
        class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
      >
        Club news
      </h2>

      <div class="mt-8 space-y-6">
        {
          renderedUpdates.map(({ entry, rendered }) => {
            const { Content } = rendered;
            return (
              <article class="bg-flyers-snow rounded-2xl border border-neutral-200 p-6 sm:p-8">
                <div class="text-flyers-iron flex flex-wrap items-center gap-2 text-xs font-bold">
                  <time datetime={entry.data.publishedDate}>
                    {formatPostDate(entry.data.publishedDate)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span class="text-flyers-red-deep uppercase">{entry.data.category}</span>
                </div>
                <h3 class="font-display text-flyers-slate-dark mt-2 text-2xl font-black tracking-wide uppercase sm:text-3xl">
                  {entry.data.title}
                </h3>
                <div class="club-prose mt-3 text-sm">
                  <Content />
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/layout/PageHero.astro';
import { siteConfig } from '../../../data/site';
import { withBase } from '../../../lib/urls';

const guides = (await getCollection('guides', (guide) => guide.data.audience === 'coaches')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Coach resources"
  description="Checklists and guides for Flyers coaches and ride leaders: running a ride, emergency plans, ride groups, and skills."
>
  <PageHero eyebrow="Coach resources" title="For coaches and ride leaders">
    <p>
      The basics for leading a Flyers ride. {siteConfig.coachScreening}
    </p>
  </PageHero>

  <section aria-labelledby="coach-guides-heading" class="py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 id="coach-guides-heading" class="sr-only">All coach resources</h2>
      <ul class="grid gap-5 sm:grid-cols-2">
        {
          guides.map((guide) => (
            <li>
              <a
                href={withBase(`/coaches/resources/${guide.id.replace(/^\d+-/, '')}`)}
                class="border-t-flyers-slate hover:border-flyers-slate/40 block h-full rounded-2xl border border-t-4 border-neutral-200 bg-white p-6 shadow-xs transition"
              >
                <h3 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
                  {guide.data.title}
                </h3>
                <p class="text-flyers-iron mt-2 text-sm leading-relaxed">{guide.data.summary}</p>
                {guide.data.needsCoachReview && (
                  <p class="text-flyers-gold-ink bg-flyers-gold-light mt-3 inline-block rounded-full px-2.5 py-0.5 text-xs font-bold">
                    Draft, in coach review
                  </p>
                )}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="text-flyers-iron mt-10 text-sm leading-relaxed">
        Want to coach? Start on the <a
          href={withBase('/volunteer')}
          class="text-flyers-red-deep font-bold underline">volunteer page</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import { siteConfig } from '../data/site';
import { anyRegistrationOpen, registrationCta, registrationOpensLabel } from '../lib/registration';
import { programTheme } from '../lib/programs';
import { withBase } from '../lib/urls';

const programs = (await getCollection('programs'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((program) => ({ ...program, cta: registrationCta(program.data.registrationForm) }));
const { season } = siteConfig.registration;
const opens = registrationOpensLabel();
const isOpen = anyRegistrationOpen();
---

<BaseLayout
  title={`${season} Registration`}
  description={`Registration for ${season} Flyers XC and Flyers Enduro/Gravity opens ${opens}. Each program has its own sign-up form.`}
>
  <PageHero
    eyebrow={`${season} season`}
    title={isOpen ? 'Registration is open' : `Registration opens ${opens}`}
  >
    <p>
      Flyers XC and Flyers Enduro/Gravity each have their own sign-up form. Riders can join more
      than one program, and beginners are always welcome. Jr. Flyers registration opens later.
    </p>
  </PageHero>

  <section aria-labelledby="register-programs-heading" class="py-14 sm:py-18">
    <div class="mx-auto max-w-7xl space-y-10 px-4 sm:px-6 lg:px-8">
      <div>
        <h2
          id="register-programs-heading"
          class="font-display text-flyers-slate-dark text-3xl font-black tracking-wide uppercase sm:text-4xl"
        >
          Pick a program
        </h2>
        <div class="mt-6 grid gap-6 lg:grid-cols-3">
          {
            programs.map(({ data, cta }) => (
              <article
                data-program={programTheme(data.accentKey)}
                class="border-t-program-accent flex flex-col justify-between rounded-2xl border border-t-4 border-neutral-200 bg-white p-6 shadow-xs"
              >
                <div>
                  <h3 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
                    <a href={withBase(`/programs/${data.programId}`)} class="hover:underline">
                      {data.title}
                    </a>
                  </h3>
                  <p class="text-flyers-iron mt-1 text-sm">{data.seasonLabel}</p>
                </div>
                {cta.isOpen ? (
                  <a
                    href={cta.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-program hover:bg-program-hover font-display mt-5 inline-flex min-h-12 items-center justify-center rounded-xl px-5 py-2.5 text-base font-extrabold tracking-wider text-white uppercase transition"
                  >
                    Register for {data.shortTitle} &rarr;
                  </a>
                ) : (
                  <p class="bg-flyers-snow text-flyers-slate-dark mt-5 rounded-xl border border-neutral-200 p-3 text-sm font-bold">
                    {cta.label}
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </div>

      <div class="max-w-3xl">
        <h2 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
          Good to know
        </h2>
        <ul class="text-flyers-iron mt-4 space-y-3 text-sm leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="text-flyers-red font-black" aria-hidden="true">&#10003;</span>
            <span
              >Riders can join more than one program, like Flyers Enduro/Gravity plus Flyers XC.
              Fill out each program's form.</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="text-flyers-red font-black" aria-hidden="true">&#10003;</span>
            <span
              >Riders need to be {siteConfig.enduroMinimumAge} or older for Flyers Enduro/Gravity.</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="text-flyers-red font-black" aria-hidden="true">&#10003;</span>
            <span
              >Each program page lists who it's for, the season, the cost, and the gear you'll need.</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="text-flyers-red font-black" aria-hidden="true">&#10003;</span>
            <span
              >If cost is a barrier, <a
                href={`mailto:${siteConfig.contact.email}?subject=Help%20with%20costs`}
                class="text-flyers-red-deep font-bold underline">ask us about help</a
              >. Requests are confidential.</span
            >
          </li>
        </ul>
        <p class="text-flyers-iron mt-6 text-sm leading-relaxed">
          Questions? Email <a
            href={`mailto:${siteConfig.contact.email}`}
            class="text-flyers-red-deep font-bold underline">{siteConfig.contact.email}</a
          >. Already signed up? See <a
            href={withBase('/onboarding')}
            class="text-flyers-red-deep font-bold underline">what to expect as a new family</a
          >.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

---
// One guide from src/content/guides, used by /learn/[slug] and /coaches/resources/[slug].
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../layout/PageHero.astro';
import { withBase } from '../../lib/urls';

interface Props {
  guide: CollectionEntry<'guides'>;
  eyebrow: string;
  backHref: string;
  backLabel: string;
}

const { guide, eyebrow, backHref, backLabel } = Astro.props;
const { Content } = await render(guide);
---

<BaseLayout title={guide.data.title} description={guide.data.summary}>
  <PageHero eyebrow={eyebrow} title={guide.data.title}>
    <p>{guide.data.summary}</p>
  </PageHero>

  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      {
        guide.data.needsCoachReview && (
          <p class="bg-flyers-gold-light text-flyers-gold-ink border-flyers-gold mb-6 rounded-xl border p-4 text-sm font-semibold">
            Draft: a Flyers coach is still reviewing this guide.
          </p>
        )
      }
      <article class="club-prose rounded-2xl border border-neutral-200 bg-white p-6 sm:p-8">
        <Content />
      </article>
      <a
        href={withBase(backHref)}
        class="text-flyers-red-deep mt-8 inline-flex min-h-12 items-center text-sm font-extrabold underline"
      >
        &larr; {backLabel}
      </a>
    </div>
  </section>
</BaseLayout>

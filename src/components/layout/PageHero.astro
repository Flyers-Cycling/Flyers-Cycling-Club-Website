---
// The dark banner at the top of an inner page: eyebrow, the page's one <h1>, and an intro.
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="dark-surface flyers-banner-bg py-14 text-white sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="text-flyers-gold text-xs font-extrabold tracking-widest uppercase">{eyebrow}</p>
    <h1
      class="font-display mt-3 max-w-3xl text-4xl leading-[0.98] font-black tracking-wide text-white uppercase sm:text-6xl"
    >
      {title}
    </h1>
    <div class="mt-4 max-w-2xl text-lg leading-relaxed text-white/90">
      <slot />
    </div>
  </div>
</section>

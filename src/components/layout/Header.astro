---
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/urls';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

interface NavLink {
  label: string;
  path: string;
}

interface NavItem extends NavLink {
  /** Pages listed in this item's dropdown. The top-level label is a link too. */
  children?: NavLink[];
}

const programDots: Record<string, string> = {
  xc: 'bg-flyers-red-bright',
  enduro: 'bg-flyers-pink',
  jr: 'bg-flyers-blue-bright',
};

const programQuickLinks = (await getCollection('programs'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => ({
    label: data.title,
    sub: data.discipline,
    path: `/programs/${data.programId}`,
    href: withBase(`/programs/${data.programId}`),
    dot: programDots[data.accentKey] ?? 'bg-white',
  }));

// Labels match each page's title (Randall, Nov 22 2026).
const navItems: NavItem[] = [
  {
    label: 'Programs',
    path: '/programs',
    children: programQuickLinks.map((prog) => ({ label: prog.label, path: prog.path })),
  },
  { label: 'Schedule', path: '/schedule' },
  {
    label: 'Parent Handbook',
    path: '/onboarding',
    children: [
      { label: 'Safety', path: '/safety' },
      { label: 'Help with costs', path: '/scholarships' },
      { label: 'Rider guides', path: '/learn' },
      { label: 'FAQ', path: '/faq' },
    ],
  },
  { label: 'Coaches', path: '/coaches' },
  { label: 'Sponsors', path: '/sponsors' },
  {
    label: 'Support',
    path: '/support',
    children: [
      { label: 'Donate', path: '/support#donate' },
      { label: 'Volunteer', path: '/volunteer' },
      { label: 'Team Kits & News', path: '/store' },
    ],
  },
  {
    label: 'About',
    path: '/about',
    children: [
      { label: 'Board', path: '/board' },
      { label: 'Brand guidelines', path: '/brand' },
    ],
  },
];

function isActive(matchPrefix: string): boolean {
  const cleanPath = currentPath.replace(import.meta.env.BASE_URL || '/', '/');
  const normalized = cleanPath.startsWith('/') ? cleanPath : `/${cleanPath}`;
  return normalized === matchPrefix || normalized.startsWith(`${matchPrefix}/`);
}

/** A top-level item is current when its own page or one of its dropdown pages is open. */
function isItemActive(item: NavItem): boolean {
  return [item, ...(item.children ?? [])].some((link) => isActive(link.path.split('#')[0]));
}
---

<header
  class="no-print dark-surface border-flyers-slate-mid bg-flyers-slate/95 sticky top-0 z-40 border-b text-white shadow-md backdrop-blur"
>
  <!-- Top Brand Accent Rule + Quick Program Bar -->
  <div class="border-flyers-red bg-flyers-slate-dark border-t-3 border-b border-b-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-4 py-1.5 text-xs sm:px-6 lg:px-8"
    >
      <p class="text-flyers-silver font-medium">
        <span class="font-bold text-white">Youth mountain biking in Utah</span> · Non-profit · Run by
        volunteers
      </p>
      <div class="hidden items-center gap-5 md:flex" aria-label="Quick program links">
        {
          programQuickLinks.map((prog) => (
            <a
              href={prog.href}
              class="hover:text-flyers-gold inline-flex items-center gap-1.5 font-semibold text-white/90 transition"
            >
              <span class={`h-2 w-2 rounded-full ${prog.dot}`} aria-hidden="true" />
              <span>{prog.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href={withBase('/')} class="group flex items-center gap-3.5">
      <img
        src={withBase('/images/brand/flyers-logo-white.svg')}
        alt=""
        width="72"
        height="51"
        class="h-11 w-auto shrink-0 transition duration-200 group-hover:scale-[1.03]"
      />
      <div class="border-l border-white/20 pl-3.5">
        <span class="sr-only">Flyers</span>
        <span
          class="font-display block text-xl leading-none font-black tracking-wider text-white uppercase sm:text-2xl"
        >
          Cycling Club
        </span>
        <span
          class="text-flyers-silver mt-0.5 hidden text-[11px] font-bold tracking-wider whitespace-nowrap uppercase sm:block xl:hidden"
        >
          XC · Enduro/Gravity · Jr. Flyers
        </span>
      </div>
    </a>

    <nav aria-label="Main navigation" class="hidden items-center gap-1 xl:flex">
      <ul class="flex items-center gap-1">
        {
          navItems.map((item, index) => {
            const active = isItemActive(item);
            const linkClass = `rounded-lg px-2.5 py-2 text-sm font-bold tracking-wide whitespace-nowrap transition ${
              active
                ? 'bg-flyers-slate-dark text-flyers-gold ring-1 ring-white/15'
                : 'text-white/90 hover:bg-white/10 hover:text-white'
            }`;
            if (!item.children) {
              return (
                <li>
                  <a
                    href={withBase(item.path)}
                    aria-current={isActive(item.path) ? 'page' : undefined}
                    class={linkClass}
                  >
                    {item.label}
                  </a>
                </li>
              );
            }
            const menuId = `nav-menu-${index}`;
            return (
              <li class="nav-dropdown relative flex items-center">
                <a
                  href={withBase(item.path)}
                  aria-current={isActive(item.path) ? 'page' : undefined}
                  class={`${linkClass} rounded-r-none pr-1`}
                >
                  {item.label}
                </a>
                <button
                  type="button"
                  class="nav-toggle flex h-9 w-6 items-center justify-center rounded-r-lg text-white/80 transition hover:bg-white/10 hover:text-white"
                  aria-expanded="false"
                  aria-controls={menuId}
                  aria-label={`${item.label} pages`}
                >
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 12 12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                    class="nav-chevron transition"
                  >
                    <path d="M2.5 4.5 6 8l3.5-3.5" />
                  </svg>
                </button>
                <div class="nav-sub absolute top-full left-0 hidden pt-2">
                  <ul
                    id={menuId}
                    class="border-flyers-slate-mid bg-flyers-slate-dark min-w-52 rounded-xl border p-1.5 shadow-xl"
                  >
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={withBase(child.path)}
                          aria-current={isActive(child.path) ? 'page' : undefined}
                          class="hover:text-flyers-gold aria-[current=page]:text-flyers-gold flex min-h-11 items-center rounded-lg px-3 text-sm font-bold whitespace-nowrap text-white/90 transition hover:bg-white/10"
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-2.5 sm:flex">
      <a
        href={withBase('/register')}
        class="rounded-lg border border-white/25 bg-white/5 px-3.5 py-2 text-sm font-bold whitespace-nowrap text-white transition hover:border-white/50 hover:bg-white/15"
      >
        Register
      </a>
      <a
        href={withBase('/support#donate')}
        class="bg-flyers-red hover:bg-flyers-red-bright font-display rounded-lg px-4 py-2 text-base font-extrabold tracking-wider whitespace-nowrap text-white uppercase shadow-sm transition"
      >
        Donate
      </a>
    </div>

    <button
      type="button"
      id="mobile-menu-open"
      aria-haspopup="dialog"
      aria-controls="mobile-nav-dialog"
      class="bg-flyers-slate-dark inline-flex min-h-12 min-w-12 items-center justify-center rounded-lg border border-white/25 p-2.5 text-white transition hover:bg-white/10 xl:hidden"
      aria-label="Open navigation menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Native accessible light-dismiss modal drawer -->
  <dialog
    id="mobile-nav-dialog"
    closedby="any"
    aria-labelledby="mobile-nav-title"
    class="dark-surface border-flyers-slate-mid bg-flyers-slate-dark m-0 ml-auto h-dvh max-h-none w-full max-w-sm border-l p-0 text-white shadow-2xl"
  >
    <div class="flex h-full flex-col justify-between p-6">
      <div>
        <div class="flex items-center justify-between border-b border-white/15 pb-4">
          <div class="flex items-center gap-3">
            <img
              src={withBase('/images/brand/flyers-symbol-white.svg')}
              alt=""
              width="40"
              height="22"
              fetchpriority="low"
              class="h-5 w-auto"
            />
            <h2
              id="mobile-nav-title"
              class="font-display text-xl font-black tracking-wider text-white uppercase"
            >
              Menu
            </h2>
          </div>
          <form method="dialog">
            <button
              type="submit"
              class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-white/25 bg-white/5 px-3 py-2 text-sm font-bold text-white hover:bg-white/15"
            >
              Close
            </button>
          </form>
        </div>

        <nav aria-label="Mobile navigation" class="mt-5">
          <p class="text-flyers-gold px-2 text-xs font-extrabold tracking-widest uppercase">
            Programs
          </p>
          <ul class="mt-2 space-y-1.5">
            {
              programQuickLinks.map((prog) => (
                <li>
                  <a
                    href={prog.href}
                    class="bg-flyers-slate/80 flex items-center justify-between rounded-lg border border-white/15 px-3.5 py-3 transition hover:border-white/40"
                  >
                    <span class="flex items-center gap-2.5 font-bold text-white">
                      <span class={`h-2.5 w-2.5 rounded-full ${prog.dot}`} aria-hidden="true" />
                      {prog.label}
                    </span>
                    <span class="text-flyers-silver text-xs">{prog.sub}</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <p class="text-flyers-gold mt-6 px-2 text-xs font-extrabold tracking-widest uppercase">
            More
          </p>
          <ul class="mt-2 space-y-1">
            {
              navItems
                .filter((item) => item.path !== '/programs')
                .map((item) => (
                  <li>
                    <a
                      href={withBase(item.path)}
                      aria-current={isActive(item.path) ? 'page' : undefined}
                      class="flex min-h-12 items-center rounded-lg px-3 text-base font-bold text-white/90 transition hover:bg-white/10 hover:text-white"
                    >
                      {item.label}
                    </a>
                    {item.children && (
                      <ul class="mb-1 ml-3 border-l border-white/15 pl-2">
                        {item.children.map((child) => (
                          <li>
                            <a
                              href={withBase(child.path)}
                              aria-current={isActive(child.path) ? 'page' : undefined}
                              class="text-flyers-silver flex min-h-12 items-center rounded-lg px-3 text-sm font-semibold transition hover:bg-white/10 hover:text-white"
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))
            }
          </ul>
        </nav>
      </div>

      <div class="space-y-2.5 border-t border-white/15 pt-4">
        <a
          href={withBase('/register')}
          class="block w-full rounded-lg border border-white/25 bg-white/5 px-4 py-3 text-center text-sm font-bold text-white hover:bg-white/15"
        >
          Registration
        </a>
        <a
          href={withBase('/support#donate')}
          class="bg-flyers-red hover:bg-flyers-red-bright font-display block w-full rounded-lg px-4 py-3 text-center text-base font-extrabold tracking-wider text-white uppercase"
        >
          Donate
        </a>
      </div>
    </div>
  </dialog>
</header>

<script>
  // Desktop dropdowns open on hover and keyboard focus (CSS). The chevron button also opens
  // them for touch screens and screen readers. Escape or a click elsewhere closes them.
  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.nav-toggle'));
  const closeAll = (except?: HTMLButtonElement) => {
    toggles.forEach((btn) => {
      if (btn !== except) btn.setAttribute('aria-expanded', 'false');
    });
  };
  toggles.forEach((btn) => {
    btn.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeAll(btn);
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  });
  document.addEventListener('click', () => closeAll());
  // Escape closes an open menu, including one shown by hover (WCAG 1.4.13). A hover menu stays
  // closed until the pointer leaves it.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const openToggle = toggles.find((btn) => btn.getAttribute('aria-expanded') === 'true');
    closeAll();
    document.querySelectorAll<HTMLElement>('.nav-dropdown:hover').forEach((item) => {
      item.dataset.dismissed = '';
    });
    openToggle?.focus();
  });
  document.querySelectorAll<HTMLElement>('.nav-dropdown').forEach((item) => {
    item.addEventListener('mouseleave', () => delete item.dataset.dismissed);
  });

  const openBtn = document.getElementById('mobile-menu-open');
  const dialog = document.getElementById('mobile-nav-dialog') as HTMLDialogElement | null;

  if (openBtn && dialog) {
    openBtn.addEventListener('click', () => {
      dialog.showModal();
    });

    // Close drawer when following same-page hash links
    dialog.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (dialog.open) dialog.close();
      });
    });

    // Safari / cross-browser fallback for declarative <dialog closedby="any">
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent =
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width;

        if (!isDialogContent) {
          dialog.close();
        }
      });
    }
  }
</script>

<style>
  .nav-dropdown:not([data-dismissed]):hover > .nav-sub,
  .nav-toggle[aria-expanded='true'] + .nav-sub {
    display: block;
  }
  .nav-dropdown:not([data-dismissed]):hover .nav-chevron,
  .nav-toggle[aria-expanded='true'] .nav-chevron {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-chevron {
      transition: none;
    }
  }
</style>

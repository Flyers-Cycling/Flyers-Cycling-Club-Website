---
// One race series card: its summary, upcoming dates, and a link to the organizer.
import type { CollectionEntry } from 'astro:content';
import { formatEventDateRange } from '../../lib/dates';
import { raceEnds } from '../../lib/races';

type Series = CollectionEntry<'races'>['data'];

interface Props {
  series: Series & { upcoming: Series['races'] };
  headingLevel: 3 | 4 | 5;
}

const { series, headingLevel } = Astro.props;
const SeriesHeading = `h${headingLevel}` as 'h3' | 'h4' | 'h5';
---

<article
  class="border-t-program-accent flex flex-col rounded-2xl border border-t-4 border-neutral-200 bg-white p-6 shadow-xs"
>
  <SeriesHeading
    class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase"
  >
    {series.series}
  </SeriesHeading>
  {
    series.optional && (
      <p class="mt-2">
        <span class="bg-flyers-snow text-flyers-slate-dark rounded-full border border-neutral-300 px-2 py-0.5 text-xs font-extrabold tracking-wide uppercase">
          Optional
        </span>
      </p>
    )
  }
  <p class="text-flyers-iron mt-2 text-sm leading-relaxed">{series.summary}</p>

  {
    series.upcoming.length > 0 ? (
      <ul class="mt-5 divide-y divide-neutral-200 border-y border-neutral-200">
        {series.upcoming.map((race) => (
          <li data-event-ends={raceEnds(race)} class="py-3">
            {race.date ? (
              <time
                datetime={race.date}
                class="text-program-ink text-xs font-extrabold tracking-wide"
              >
                {formatEventDateRange(race.date, race.endDate)}
              </time>
            ) : (
              <p class="text-flyers-slate-dark text-xs font-extrabold tracking-wide">
                <span class="bg-flyers-snow mr-1.5 rounded-full border border-neutral-300 px-2 py-0.5">
                  Date TBD
                </span>
                {race.dateLabel}
              </p>
            )}
            <p class="text-flyers-slate-dark mt-1 font-bold">{race.name}</p>
            <p class="text-flyers-iron text-xs">{race.location}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-flyers-iron mt-5 text-sm">
        This season's races are done. Next year's dates go up once the series posts them.
      </p>
    )
  }

  {series.note && <p class="text-flyers-iron mt-3 text-xs">{series.note}</p>}

  <a
    href={series.website}
    target="_blank"
    rel="noopener noreferrer"
    class="text-program-ink mt-auto inline-flex min-h-12 items-center pt-4 text-sm font-extrabold underline"
  >
    {series.series} schedule and sign-up
    <span class="sr-only"> (opens in a new tab)</span>
  </a>
</article>

---
// The race series a program follows, with each series' upcoming dates. Content lives in
// src/content/races/. Past races drop off; races with no date yet show their dateLabel.
import { getCollection } from 'astro:content';
import RaceSeriesCard from './RaceSeriesCard.astro';
import { upcomingRaces } from '../../lib/races';
import { programTheme } from '../../lib/programs';
import { withBase } from '../../lib/urls';

interface Props {
  program: 'xc' | 'enduro' | 'jr-flyers';
  // Unique id for the section heading, so the section can be labelled.
  headingId: string;
  title: string;
  intro: string;
  // The section's id. Program pages use 'races' for their in-page link; the schedule page
  // shows more than one program, so it passes its own.
  sectionId?: string;
  // 2 on program pages. 3 when the list sits inside a larger section, as on /schedule.
  headingLevel?: 2 | 3;
  // The "Talk to a coach" link under the intro. /schedule shows it once for all programs.
  showCoachLink?: boolean;
}

const {
  program,
  headingId,
  title,
  intro,
  sectionId = 'races',
  headingLevel = 2,
  showCoachLink = true,
} = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
// Optional races sit under their own subheading, so their series headings go one level deeper.
const GroupHeading = headingLevel === 2 ? 'h3' : 'h4';
const seriesLevel = headingLevel === 2 ? 3 : 4;
const optionalSeriesLevel = headingLevel === 2 ? 4 : 5;

const seriesList = (await getCollection('races'))
  .filter((entry) => entry.data.program === program)
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ ...entry.data, upcoming: upcomingRaces(entry.data.races) }));
const mainSeries = seriesList.filter((series) => !series.optional);
const optionalSeries = seriesList.filter((series) => series.optional);
const optionalHeadingId = `${headingId}-optional`;
---

{
  seriesList.length > 0 && (
    <section
      id={sectionId}
      aria-labelledby={headingId}
      data-program={programTheme(program)}
      class="scroll-mt-24"
    >
      <Heading
        id={headingId}
        class:list={[
          'font-display text-flyers-slate-dark leading-tight font-black tracking-wide uppercase',
          headingLevel === 2 ? 'text-3xl sm:text-4xl' : 'text-2xl sm:text-3xl',
        ]}
      >
        {title}
      </Heading>
      <p class="text-flyers-iron mt-2 max-w-3xl text-sm leading-relaxed sm:text-base">{intro}</p>
      {showCoachLink && (
        <p class="text-flyers-iron text-sm sm:text-base">
          Not sure which races fit your rider?{' '}
          <a
            href={withBase('/coaches')}
            class="text-program-ink inline-flex min-h-12 items-center font-extrabold underline"
          >
            Talk to a coach
          </a>
        </p>
      )}

      {mainSeries.length > 0 && (
        <div class="mt-8 grid gap-6 lg:grid-cols-3">
          {mainSeries.map((series) => (
            <RaceSeriesCard series={series} headingLevel={seriesLevel} />
          ))}
        </div>
      )}

      {optionalSeries.length > 0 && (
        <div role="group" aria-labelledby={optionalHeadingId} class="mt-10">
          <GroupHeading
            id={optionalHeadingId}
            class="font-display text-flyers-slate-dark text-xl font-black tracking-wide uppercase sm:text-2xl"
          >
            Optional endurance races
          </GroupHeading>
          <p class="text-flyers-iron mt-2 max-w-3xl text-sm leading-relaxed sm:text-base">
            Longer events some riders add for a bigger challenge. They aren't part of the regular
            race plan, and nobody is expected to do them. Talk to a coach before you sign up.
          </p>
          <div class="mt-6 grid gap-6 lg:grid-cols-3">
            {optionalSeries.map((series) => (
              <RaceSeriesCard series={series} headingLevel={optionalSeriesLevel} />
            ))}
          </div>
        </div>
      )}
    </section>
  )
}

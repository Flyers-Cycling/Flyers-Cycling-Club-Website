---
import type { CollectionEntry } from 'astro:content';
import { getRegistrationStatusMeta, programClasses, programTheme } from '../../lib/programs';
import { withBase } from '../../lib/urls';
import { effectiveRegistrationStatus, registrationCta } from '../../lib/registration';

interface Props {
  programs: CollectionEntry<'programs'>[];
}

const { programs } = Astro.props;
const sorted = [...programs].sort((a, b) => a.data.order - b.data.order);
import PhotoPlaceholder from '../layout/PhotoPlaceholder.astro';
---

<div class="grid gap-8 lg:grid-cols-3">
  {
    sorted.map((program) => {
      const { data } = program;
      const statusMeta = getRegistrationStatusMeta(
        effectiveRegistrationStatus(data.registrationStatus, data.registrationForm),
      );
      const register = registrationCta(data.registrationForm);
      const theme = programTheme(data.accentKey);
      const programHref = withBase(`/programs/${data.programId}`);

      return (
        <article
          data-program={theme}
          class={`group flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm transition ${programClasses.hoverBorder}`}
        >
          <div class={`h-2 w-full ${programClasses.bar}`} aria-hidden="true" />
          <div class="bg-flyers-slate-dark relative aspect-[16/9] w-full overflow-hidden">
            {data.heroImage ? (
              <img
                src={withBase(data.heroImage)}
                alt={data.heroImageAlt}
                width="1200"
                height="669"
                loading="lazy"
                class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
              />
            ) : (
              <PhotoPlaceholder tone="bg-program" />
            )}
          </div>

          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span
                  class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-extrabold ${programClasses.badge}`}
                >
                  {data.discipline}
                </span>
                <span
                  class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-bold ${statusMeta.badgeClass}`}
                >
                  <span class={`h-2 w-2 rounded-full ${statusMeta.dotClass}`} aria-hidden="true" />
                  {statusMeta.label}
                </span>
              </div>

              <h3 class="font-display text-flyers-slate-dark mt-4 text-3xl font-black tracking-wide uppercase">
                <a href={programHref} class="hover:text-program-ink transition hover:underline">
                  {data.title}
                </a>
              </h3>
              <p class="text-flyers-iron mt-2 text-sm leading-relaxed">{data.summary}</p>
              {data.groups && (
                <ul class="mt-4 space-y-2">
                  {data.groups.map((group) => (
                    <li class="bg-flyers-snow rounded-xl border border-neutral-200/80 p-3 text-xs">
                      <a
                        href={withBase(`/programs/${data.programId}#${group.id}`)}
                        class="text-flyers-slate-dark font-extrabold hover:underline"
                      >
                        {group.name}
                      </a>
                      <p class="text-flyers-iron mt-0.5 leading-relaxed">
                        {group.summary.split('. ')[0]}.
                      </p>
                    </li>
                  ))}
                </ul>
              )}

              <dl class="bg-flyers-snow mt-5 rounded-xl border border-neutral-200/80 p-3.5 text-xs">
                <dt class="text-flyers-iron font-bold">Season</dt>
                <dd class="text-flyers-charcoal mt-0.5 font-semibold">{data.seasonLabel}</dd>
              </dl>
            </div>

            <div class="mt-6 flex items-center justify-between gap-3 border-t border-neutral-100 pt-4">
              <a
                href={programHref}
                class={`font-display inline-flex min-h-12 items-center justify-center rounded-lg px-4 py-2 text-base font-extrabold tracking-wider uppercase transition ${programClasses.button}`}
              >
                Explore {data.shortTitle} &rarr;
              </a>
              <a
                href={register.href}
                target={register.external ? '_blank' : undefined}
                rel={register.external ? 'noopener noreferrer' : undefined}
                class="text-flyers-slate hover:text-program-ink text-right text-xs font-extrabold underline transition"
              >
                {register.label}
              </a>
            </div>
          </div>
        </article>
      );
    })
  }
</div>
